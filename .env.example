# Токен от @BotFather
BOT_TOKEN=
# База: PostgreSQL, если задан DATABASE_URL, иначе файл SQLite из HABIT_DB (по умолчанию habits.db)
# DATABASE_URL=postgresql://habitbot:пароль@127.0.0.1:5432/habitbot
# HABIT_DB=habits.db
# Часовой пояс по умолчанию для новых пользователей
# DEFAULT_TZ=Europe/Moscow
# Мотивация к напоминаниям: ключ OpenRouter (без него — готовые фразы) и модель
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=~anthropic/claude-sonnet-latest
# Прокси для Telegram и OpenRouter (http:// или socks5://), если с сервера они напрямую недоступны
# PROXY_URL=http://127.0.0.1:10809
